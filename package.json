
{
  "name": "handsfree",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:extension": "cd extension && npm run build",
    "zip:extension": "cd extension && npm run zip",
    "test:extension": "cd extension && npm run test",
    "build:site": "cd site && npm run build",
    "dev:site": "cd site && npm run dev",
    "build": "cd extension && npm run build && npm run zip && cd ../site && npm run build",
    "test": "cd extension && npm run test",
    "lint": "npm run compile && npm test",
    "compile": "cd extension && npm run compile"
  }
}
