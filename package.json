{
  "name": "handsfree",
  "description": "Handsfree browser extension - touchless control with head movement and voice.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/chrome": "^0.0.308",
    "eslint": "^9.20.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
